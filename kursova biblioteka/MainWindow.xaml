<Window x:Class="kursova_biblioteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kursova_biblioteka"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Menu  Grid.RowSpan="2" Margin="0,20,0,0">
                <MenuItem  Header="Add a author" Command="{Binding AddBooks}"  Height="19"/>
            </Menu>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </StackPanel>


            <ListView Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBooks}" Margin="0,40,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Заголовок" Width="120" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="Автор книги"  Width="90" DisplayMemberBinding="{Binding Author.FIO}"/>
                        <GridViewColumn Header="Дата издания" Width="90" DisplayMemberBinding="{Binding Year_published}"/>
                        <GridViewColumn Header="Жанр" Width="80" DisplayMemberBinding="{Binding Genre}"/>
                       
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete"  />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
            <StackPanel Grid.Row="1" Grid.Column="1" >
                <StackPanel DataContext="{Binding SelectedBooks}">
                    <TextBlock Text="Changing the selected record"/>
                    <TextBlock Text="Заголовок"/>
                    <TextBox Text="{Binding Title}"/>

                    <TextBlock Text="Автор"/>
                    <TextBox Text="{Binding Author_id}"/>

                    <TextBlock Text="Дата издании"/>
                    <TextBox Text="{Binding Year_published}"/>

                    <TextBlock Text="Жанр"/>
                    <TextBox Text="{Binding Genre}"/>


                </StackPanel>
                <Button Content="Save changes" Command="{Binding UpdateBooks}"/>
            </StackPanel>

        </Grid>
    </Grid>
  </Window>
